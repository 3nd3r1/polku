{
  "name": "polku",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "agent:push": "tsx agent/sync.ts && cd agent && elevenlabs tools push && elevenlabs agents push",
    "start:prod": "drizzle-kit push --force && tsx src/db/seed.ts --if-empty && next start -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@elevenlabs/react": "1.22.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elevenlabs/cli": "^1.11.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
