DATABASE_URL=postgres://polku:polku@localhost:5433/polku
# Public ElevenLabs agent id (Agents dashboard). Leave empty to hide the call button.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# 1 only on the public demo deployment: scripted calls only, no voice, reset open to anyone.
NEXT_PUBLIC_DEMO_SITE=

# Shared password for the whole site (production). Empty means open. Any user name works.
SITE_PASSWORD=

# Real phone line (production). `npm run agent:phone` sets up the phone agent and prints the two ids.
ELEVENLABS_API_KEY=
PHONE_WEBHOOK_SECRET=
PHONE_AGENT_ID=
PHONE_NUMBER_ID=
# Every callback rings this number in the demo (the register is synthetic). E.164, e.g. +358401234567.
DEMO_CALLBACK_NUMBER=
